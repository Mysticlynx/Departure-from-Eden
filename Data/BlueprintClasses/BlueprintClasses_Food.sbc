<?xml version="1.0"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <BlueprintClasses>

		<!-- Food Processor -->
        <Class>
            <Id>
                <TypeId>BlueprintClassDefinition</TypeId>
                <SubtypeId>FoodProcessorRations</SubtypeId>
            </Id>
            <DisplayName>DisplayName_BlueprintClass_FoodItems</DisplayName>
            <Description>Description_BlueprintClass_FoodItems</Description>
            <Icon>Textures\GUI\Icons\buttons\Food.dds</Icon>
            <HighlightIcon>Textures\GUI\Icons\buttons\Food.dds</HighlightIcon>
            <FocusIcon>Textures\GUI\Icons\buttons\FoodFocus.dds</FocusIcon>
			<InputConstraintIcon>Textures\GUI\Icons\filter_foodcontainer.dds</InputConstraintIcon>
			<OutputConstraintIcon>Textures\GUI\Icons\filter_food.dds</OutputConstraintIcon>
			<InputConstraintDescription>ToolTipItemFilter_FoodProcessorInput</InputConstraintDescription>
        </Class>
		
        <Class>
            <Id>
                <TypeId>BlueprintClassDefinition</TypeId>
                <SubtypeId>FoodProcessorSeeds</SubtypeId>
            </Id>
            <DisplayName>DisplayName_BlueprintClass_GardenItems</DisplayName>
            <Description>Description_BlueprintClass_GardenItems</Description>
            <Icon>Textures\GUI\Icons\buttons\Garden.dds</Icon>
            <HighlightIcon>Textures\GUI\Icons\buttons\Garden.dds</HighlightIcon>
            <FocusIcon>Textures\GUI\Icons\buttons\GardenFocus.dds</FocusIcon>
        </Class>

        <Class>
            <Id>
                <TypeId>BlueprintClassDefinition</TypeId>
                <SubtypeId>BasicFoodProcessorRations</SubtypeId>
            </Id>
            <DisplayName>DisplayName_BlueprintClass_FoodItems</DisplayName>
            <Description>Description_BlueprintClass_FoodItems</Description>
